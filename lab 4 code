#include <xc.h>
#pragma config FNOSC = LPFRC;

int main(void)
{
    _RCDIV = 0b000;

    OC2CON = 0;
    OC2CON2 = 0;
    OC2CONbits.OCTSEL = 0b111;
    OC2CONbits.SYNCSEL = 0b11111;
    OC2CON2bits.OCTRIG = 0;
    OC2RS = 3999; //period
    OC2R = OC2RS; //duty cycle


    while(1)
    { 
        if (_RB0 = 1){
            OC2R = OC2RS/2;
                }
        }
        else{
            OC2R = OC2RS;
        }
    }

    return 0;
}
